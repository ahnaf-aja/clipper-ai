# ---- Core ----
DATABASE_URL="file:./dev.db"
# 32+ char random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
APP_URL="http://localhost:3000"

# ---- AI (optional) ----
# When set, real LLM discourse analysis is used for segment discovery + scoring.
# When unset, the deterministic local analyzer is used instead (app still works end-to-end).
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# ---- Speech-to-text ----
# "auto" (Whisper, falling back to YouTube captions) | "faster-whisper" | "openai" | "youtube"
ASR_PROVIDER="auto"
OPENAI_API_KEY=""

# tiny | base | small | medium | large-v3 | large-v3-turbo
# Benchmarked on Indonesian speech (CPU, int8):
#   small          1.2x realtime, conf 0.66 — mangles slang and names
#   medium         3.7x realtime, conf 0.71 — accurate but far too slow
#   large-v3-turbo 0.4x realtime, conf 0.74 — most accurate AND fastest
# Turbo is a ~1.6 GB download on first use.
WHISPER_MODEL="large-v3-turbo"
# "cpu" or "cuda". CUDA is roughly 10x faster.
WHISPER_DEVICE="cpu"
# int8 (cpu) | float16 (cuda)
WHISPER_COMPUTE="int8"
# Interpreter with faster-whisper installed. Blank = auto-detect.
PYTHON_PATH=""

# Produce an invented transcript when no real one is available. Off by default:
# the subtitles would not match the audio. Leave this false in production.
ALLOW_SIMULATED_TRANSCRIPT="false"

# ---- Media toolchain ----
# Leave blank to use the bundled binaries (ffmpeg-static / ffprobe-static and
# ./bin/yt-dlp from `npm run install:ytdlp`), falling back to PATH.
# Set an absolute path here to force a specific system install instead.
FFMPEG_PATH=""
FFPROBE_PATH=""
YTDLP_PATH=""

# ---- Storage ----
STORAGE_DIR="./storage"
MAX_SOURCE_MINUTES="180"

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="60"
